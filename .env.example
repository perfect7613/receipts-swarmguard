# Local secrets only. Never commit .env.
NEATLOGS_API_KEY=
# Optional, to use an EU project.
NEATLOGS_ENDPOINT=
# Live OpenAI-compatible model adapter. Codex CLI can use its own existing auth.
OPENAI_API_KEY=
OPENAI_BASE_URL=
RECEIPTS_MODEL=
# Optional measured rate inputs; empty means cost unknown.
RECEIPTS_INPUT_USD_PER_MILLION=
RECEIPTS_OUTPUT_USD_PER_MILLION=
# cfo.ai's remote MCP uses authenticated access, not the neatlogs key.
# Obtain a valid access token through cfo.ai authentication, or use Codex MCP OAuth.
CFO_AI_ACCESS_TOKEN=
