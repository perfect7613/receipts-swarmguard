        "contract": "Sequential simulated checkout: a first valid request creates one charge; same key and payload returns the same receipt without another charge; same key with changed amount returns 409 without mutation; distinct keys are independent; missing key or nonpositive integer amount returns 400 without mutation. Request is {key: string, amount: integer}; ledger is a list of {key, amount, receipt}. Return {status, receipt, ledger}.",
        "signature": "checkout('request', 'ledger')",
        "original_source": "def checkout(request, ledger):\n    key = request.get(\"key\")\n    amount = request.get(\"amount\", 0)\n    if not key or amount <= 0:\n        return {\"status\": 400, \"receipt\": None, \"ledger\": ledger}\n    for charge in ledger:\n        if charge[\"key\"] == key:\n            if charge[\"amount\"] != amount:\n                return {\"status\": 409, \"receipt\": None, \"ledger\": ledger}\n            return {\"status\": 500, \"receipt\": None, \"ledger\": ledger}\n    receipt = key\n    ledger.append({\"key\": key, \"amount\": amount, \"receipt\": receipt})\n    return {\"status\": 200, \"receipt\": receipt, \"ledger\": ledger}\n",
