      "role": "repair",
      "reply": {
        "source": "def checkout(request, ledger):\n    key = request.get(\"key\")\n    amount = request.get(\"amount\", 0)\n    if not key or amount <= 0:\n        return {\"status\": 400, \"receipt\": None, \"ledger\": ledger}\n    for entry in ledger:\n        if entry.get(\"key\") == key:\n            if entry.get(\"amount\") == amount:\n                return {\"status\": 200, \"receipt\": entry.get(\"receipt\"), \"ledger\": ledger}\n            else:\n                return {\"status\": 409, \"receipt\": None, \"ledger\": ledger}\n    receipt = key\n    ledger.append({\"key\": key, \"amount\": amount, \"receipt\": receipt})\n    return {\"status\": 200, \"receipt\": receipt, \"ledger\": ledger}\n",
        "statement": "Repairs replay handling by returning the existing receipt without appending, and returns 409 for a reused key with a changed amount. The supplied verification showed duplicate charges on replay and mutation on payload conflict; no hidden tests were run. [execution-003]",
        "evidence_ids": [
          "execution-003"
        ],
        "approved": true
      }
